generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

// url = env("DATABASE_URL") を削除しました
datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  projects      Project[]
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Technology {
  id        String              @id @default(uuid())
  name      String              @unique
  category  String
  projects  ProjectTechnology[]
  // Connectionのfrom/toとしてのリレーション
  edgesFrom Connection[]        @relation("FromTech")
  edgesTo   Connection[]        @relation("ToTech")
}

model Project {
  id           String              @id @default(uuid())
  title        String
  description  String?
  period       String?
  githubUrl    String?
  userId       String
  user         User                @relation(fields: [userId], references: [id])
  technologies ProjectTechnology[]
  connections  Connection[]
  isPublic     Boolean             @default(false)
}

model ProjectTechnology {
  projectId    String
  technologyId String
  positionX    Float      @default(0)
  positionY    Float      @default(0)
  project      Project    @relation(fields: [projectId], references: [id])
  technology   Technology @relation(fields: [technologyId], references: [id])

  @@id([projectId, technologyId])
}

model Connection {
  id          String     @id @default(uuid())
  projectId   String
  fromTechId  String
  toTechId    String
  label       String
  description String?
  project     Project    @relation(fields: [projectId], references: [id])
  fromTech    Technology @relation("FromTech", fields: [fromTechId], references: [id])
  toTech      Technology @relation("ToTech", fields: [toTechId], references: [id])
}
